// TypeScript 설정 (tsconfig.json)
//
// 이 파일이 하는 일
//   TypeScript가 코드를 어떤 규칙으로 검사할지 정해요.
//   TypeScript는 자바스크립트에 "타입"을 더한 언어로, 실행 전에 실수를 찾아 줘요.
//   (tsconfig.json은 주석을 쓸 수 있는 특별한 JSON이에요. package.json에는 주석을 쓸 수 없어요.)
//
// 실행: pnpm typecheck
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // 어느 버전의 자바스크립트 문법까지 쓸지
    "target": "ES2022",
    // 쓸 수 있는 기본 기능: 브라우저(dom)와 최신 자바스크립트(esnext)
    "lib": ["dom", "dom.iterable", "esnext"],
    // .js 파일도 함께 다룰 수 있게
    "allowJs": true,
    // node_modules 안 라이브러리의 타입 파일까지 검사하지는 않아요(빨라져요).
    "skipLibCheck": true,
    // 엄격 모드: null 확인 빠뜨리기 같은 실수를 더 꼼꼼히 잡아요. 꼭 켜 두세요!
    "strict": true,
    // 검사만 하고 .js 파일은 만들지 않아요(만드는 일은 Next.js가 해요).
    "noEmit": true,
    "esModuleInterop": true,
    // import/export 문법(ES 모듈)을 쓰고, 모듈 위치는 번들러(Next.js) 방식으로 찾아요.
    "module": "esnext",
    "moduleResolution": "bundler",
    // .json 파일을 import할 수 있게
    "resolveJsonModule": true,
    // 파일 하나씩 따로 변환해도 안전한 코드만 쓰게 해요(Next.js가 그렇게 변환해요).
    "isolatedModules": true,
    // JSX(<div>...</div>)를 React 방식으로
    "jsx": "react-jsx",
    // 지난 검사 결과를 기억해 다음 검사를 빠르게
    "incremental": true,
    // 편집기에서 Next.js 전용 도움말을 보여 주는 플러그인
    "plugins": [{ "name": "next" }],
    // "@/" 줄임 경로: import ... from "@/lib/site" 는 src/lib/site.ts를 뜻해요.
    // ../../../ 처럼 긴 상대 경로를 쓰지 않아도 돼요.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // 검사할 파일
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  // 검사하지 않을 폴더
  "exclude": ["node_modules"]
}
