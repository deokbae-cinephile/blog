# 서버 환경 변수 예시 (.env.example)
#
# 이 파일을 .env.local로 복사해 값을 채우면 내 컴퓨터의 개발 서버(pnpm dev)와 Workers 미리보기(pnpm cf:preview)가 읽어요.
# 배포할 때는 Cloudflare 대시보드 → Workers & Pages → blog → Settings → Variables and Secrets에
# 같은 이름으로 넣어요(종류는 Secret). 순서는 docs/development.md의 "5. 배포"를 보세요.
# .env.local은 비밀 값이 들어가서 Git에 올리지 않아요(.gitignore). 이 예시 파일만 올려요.

# ── 글쓴이 로그인 ──────────────────────────────────────────────
# 글쓴이 아이디. 이 블로그는 이 아이디 한 사람만 로그인할 수 있어요.
ADMIN_ID=deokbae
# 글쓴이 비밀번호의 해시와, 로그인 표에 서명할 비밀 열쇠예요.
# `pnpm admin-secrets`를 실행해 비밀번호를 두 번 입력하면 두 값을 만들어 줘요(비밀번호 자체는 어디에도 저장하지 않아요).
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── 리뷰 저장(GitHub 저장소에 커밋) ────────────────────────────
# 이 저장소 하나에만 권한을 준 GitHub 토큰(fine-grained personal access token)이에요.
#   만드는 곳: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   Repository access: Only select repositories → deokbae-cinephile/blog
#   Permissions → Repository permissions → Contents: Read and write
# 토큰은 서버에만 두고 브라우저로는 보내지 않아요. 기한이 지나면 새로 만들어 바꿔 넣어요.
GITHUB_CONTENT_TOKEN=
# (없어도 됨) 다른 저장소·브랜치에 저장할 때만 적어요. 기본값은 src/lib/site.ts의 repo예요.
# GITHUB_REPOSITORY=deokbae-cinephile/blog
# GITHUB_BRANCH=main

# ── 사이트 주소 ─────────────────────────────────────────────────
# 검색엔진용 대표 주소와 사이트맵에 쓰는 전체 주소예요. 없으면 https://deokbae.blog를 써요(src/lib/site.ts).
# 다른 주소에 올릴 때만 적어요.
# SITE_URL=https://deokbae.blog
